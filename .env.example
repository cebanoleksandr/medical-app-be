NODE_ENV=development
PORT=3000
# Set to true when running behind a reverse proxy (Render, Railway, ...)
TRUST_PROXY=false
# API docs at /api/docs (defaults to on outside production)
SWAGGER_ENABLED=true

# Frontend origin: CORS + base for the magic link (APP_URL/auth/verify?token=...)
APP_URL=http://localhost:5173

DATABASE_URL=postgres://deid:deid@localhost:5440/deid
# true for managed Postgres such as Neon
DATABASE_SSL=false

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
MAGIC_LINK_TTL_MINUTES=15
MAGIC_LINK_MAX_PER_WINDOW=5

# Production: COOKIE_SECURE=true. Use COOKIE_SAMESITE=none only if the frontend
# and API live on different sites and you can't proxy /api through the frontend host.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# console (dev: link printed to the log) | resend | brevo (production: resend or brevo)
MAIL_PROVIDER=console
RESEND_API_KEY=
BREVO_API_KEY=
# Resend: an address on your verified domain, e.g. noreply@your-domain.com
# (onboarding@resend.dev works for tests, but only to your Resend account email)
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=De-ID Studio
# Where landing page contact form messages are sent (your team inbox).
# Without your own domain in Resend it must be the email of your Resend account.
CONTACT_TO_EMAIL=

# Presidio detection service (presidio/). Same key must be set on both sides.
PRESIDIO_URL=http://localhost:5001
PRESIDIO_API_KEY=
PRESIDIO_TIMEOUT_MS=60000

# HMAC key for pseudonyms (OutputMode.PSEUDONYMIZE). Generate like JWT_ACCESS_SECRET.
PSEUDONYM_SECRET=

# Generated synthetic datasets can be previewed/downloaded for this long
SYNTH_DATASET_TTL_MINUTES=60
# Audit events older than this are deleted
AUDIT_RETENTION_DAYS=365

# Encrypts stored file profiles / document templates (32 bytes, base64 or base64url):
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SOURCE_ENCRYPTION_KEY=
